{
  "compilerOptions": {
    "strict": false,
    "module": "esnext",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "nsjsx",
    "noEmitHelpers": true,
    "skipLibCheck": true,
    "lib": [
      "ESNext",
      "dom"
    ],
    "types": [
      "@nativescript/types"
    ],
    "paths": {
      "nsjsx/jsx-runtime": [
        "./src/nsjsx/jsx-runtime.ts"
      ]
    }
  },
  "include": [
    "src/**/*"
  ]
}
