{
  "compilerOptions": {
    "strict": false,
    "module": "esnext",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "nsjsx",
    "paths": { "nsjsx/jsx-runtime": ["./src/nsjsx/jsx-runtime.ts"] },
    "noEmitHelpers": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "dom"],
    "types": ["@nativescript/types"]
  },
  "include": ["src/**/*"]
}
