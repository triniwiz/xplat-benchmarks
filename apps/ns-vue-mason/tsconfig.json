{
  "compilerOptions": {
    "strict": false,
    "module": "esnext",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "noEmitHelpers": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "dom"],
    "types": ["@nativescript/types"]
  },
  "include": ["src/**/*"],
  "vueCompilerOptions": { "target": 3, "lib": "nativescript-vue" }
}
