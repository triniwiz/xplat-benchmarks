{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@lynx-js/react",
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@lynx-js/types"]
  },
  "include": ["src"]
}
